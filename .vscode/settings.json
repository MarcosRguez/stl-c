{
	"C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
	"cmake.debugConfig": {
		"additionalSOLibSearchPath": "",
		"args": [],
		"console": "integratedTerminal",
		"coreDumpPath": "",
		// "customLaunchSetupCommands": [],
		"cwd": "${workspaceRoot}",
		// "dumpPath": "",
		"environment": [],
		"externalConsole": false,
		// "launchCompleteCommand": "",
		// "logging": {},
		"miDebuggerPath": "/usr/bin/gdb",
		"MIMode": "gdb",
		"setupCommands": [
			{
				"description": "Habilitar la impresión con sangría para gdb",
				"text": "-enable-pretty-printing",
				"ignoreFailures": false
			},
			{
				"description": "Establecer tipo de desensamblado en Intel",
				"text": "-gdb-set disassembly-flavor intel",
				"ignoreFailures": false
			},
			{
				"description": "dsakflajsd",
				"text": "add-auto-load-safe-path /usr/local/lib64/libstdc++.so.6.0.36-gdb.py",
				"ignoreFailures": false
			},
			{
				"description": "dsakflajsd",
				"text": "python import sys; sys.path.insert(0, \"/usr/local/share/gcc-16.2.0/python\")",
				"ignoreFailures": false
			},
			{
				"description": "dsakflajsd",
				"text": "python import libstdcxx.v6",
				"ignoreFailures": false
			},
			{
				"description": "dsakflajsd",
				"text": "python libstdcxx.v6.register_libstdcxx_printers(None)",
				"ignoreFailures": false
			}
		],
		"stopAtEntry": false,
		// "symbolSearchPath": "",
		// "type": "",
		// "visualizerFile"
	}
}